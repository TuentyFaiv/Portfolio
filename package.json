{
	"name": "portfolio",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"imports": {
		"#lib/*": "./src/logic/*",
		"#config": "./src/logic/config.ts",
		"#blog/*": "./src/ui/blog/*",
		"#home/*": "./src/ui/home/*",
		"#sharing/*": "./src/ui/sharing/*",
		"#story/*": "./src/ui/story/*",
		"#styles": "./src/ui/sharing/styles/index.ts",
		"#styles/*": "./src/ui/sharing/styles/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"gen": "wrangler types",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@fontsource-variable/mulish": "5.3.0",
		"@fontsource-variable/orbitron": "5.3.0",
		"animejs": "^4.5.0",
		"mode-watcher": "1.1.0",
		"sanitize-html": "2.18.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.4",
		"@chromatic-com/storybook": "5.6.0",
		"@inlang/paraglide-js": "2.29.3",
		"@playwright/test": "1.64.1",
		"@storybook/addon-a11y": "10.6.5",
		"@storybook/addon-docs": "10.6.5",
		"@storybook/addon-svelte-csf": "5.1.6",
		"@storybook/addon-themes": "10.6.5",
		"@storybook/addon-vitest": "10.6.5",
		"@storybook/sveltekit": "10.6.5",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.6",
		"@types/sanitize-html": "2.16.2",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "5.1.0",
		"playwright": "1.64.1",
		"storybook": "10.6.5",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "3.1.0",
		"wrangler": "4.156.2"
	},
	"overrides": {
		"postcss-selector-parser": "^6.1.5"
	}
}
