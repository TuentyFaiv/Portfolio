{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"compatibility_date": "2026-05-26",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"ratelimits": [
		{
			"name": "CSP_REPORT_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "STARS_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	// Which browsers found every star on the Projects slide: one row each, read privately
	// (src/routes/api/stars/+server.ts says how). No database_id: `wrangler deploy` creates it.
	"d1_databases": [
		{
			"binding": "FINDERS",
			"database_name": "portfolio-finders"
		}
	],
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		},
		"issues": {
			"enabled": true
		}
	},
	"upload_source_maps": true
}
